{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "像素工坊",
  "version": "1.3.2",
  "identifier": "com.pixelboard.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/copy-ui.mjs",
    "beforeBuildCommand": "node scripts/copy-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
